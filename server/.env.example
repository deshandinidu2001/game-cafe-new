# ─── Server Configuration ────────────────────────────────────────────────────

# TCP Server port for client connections
TCP_PORT=9000

# HTTP REST API port (optional management API)
HTTP_PORT=3000

# Log level: "debug" | "info" | "warn" | "error"
LOG_LEVEL=info

# Keep-alive ping interval in milliseconds (sent to each connected client)
PING_INTERVAL_MS=15000

# Client socket timeout in milliseconds (client is dropped if silent this long)
SOCKET_TIMEOUT_MS=60000

# Optional: comma-separated IP whitelist. Leave empty to allow all.
# Example: ALLOWED_IPS=192.168.1.10,192.168.1.11
ALLOWED_IPS=

# Optional: Absolute path to GameCafeClient.exe for the "Launch Client" dashboard button.
# Leave empty to auto-detect from the standard build output path.
# Example: CLIENT_EXE_PATH=C:\game-cafe\client\GameCafeClient\bin\Release\net10.0-windows\GameCafeClient.exe
CLIENT_EXE_PATH=
